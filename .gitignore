# Real environment files, never the committed *.env.example templates.
# Next.js loads .env.local, .env.development.local and .env.production.local in
# addition to .env / .env.production — all of them can hold real secrets.
.env
.env.production
.env*.local
*.log
data/evidence/
data/exports/
coverage/

