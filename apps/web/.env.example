# Every NEXT_PUBLIC_* value below is inlined by the compiler at BUILD time, in
# the server bundle as well as the browser one. Changing any of them in a hosting
# dashboard has NO effect until the next redeploy — none of these is a runtime
# switch.

# Base URL of the Rishwat.fyi API (apps/api). Server-side calls use this value,
# so it may be a private/internal origin.
#
# REQUIRED for a production deploy: next.config.ts fails the build when
# VERCEL_ENV=production and neither this nor NEXT_PUBLIC_API_BASE_URL is set.
# Unguarded, the site would silently fall back to http://localhost:8787, every
# fetch would fail, and readers would be served the bundled sample dataset.
API_BASE_URL=http://localhost:8787

# The base URL a BROWSER can reach. Used for anything a reader follows or copies:
# dataset download links, the documented base URL on /data/api, the curl snippets
# on /mirroring. Must be publicly resolvable — do not point this at an internal
# hostname even if API_BASE_URL is one.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787

# Canonical site origin, used for metadataBase, canonical links, Open Graph image
# URLs, sitemap.xml and robots.txt. If unset, the build falls back to Vercel's
# VERCEL_PROJECT_PRODUCTION_URL, then to localhost — and a sitemap full of
# localhost URLs will get the site de-indexed. Set it explicitly for a custom
# domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# When the API is unreachable, render the bundled sample dataset instead of an
# error state. Every page that does so shows a visible "sample data" strip.
# Set to "false" in production so outages surface as outages rather than as a
# working-looking site full of invented fees.
NEXT_PUBLIC_ALLOW_SAMPLE_FALLBACK=true

# Plausible Analytics — privacy-respecting, no cookie banner needed.
# Leave blank to disable analytics (e.g. in dev/local).
# For Plausible Cloud: NEXT_PUBLIC_PLAUSIBLE_DOMAIN=rishwat.fyi
# For self-hosted: also set NEXT_PUBLIC_PLAUSIBLE_HOST=https://your-plausible.example.com
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_PLAUSIBLE_HOST=

# Sentry error tracking — catches runtime errors in production.
# Get DSN from https://sentry.io — leave blank to disable.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Cloudflare Turnstile CAPTCHA (free, privacy-friendly)
# Get keys at https://dash.cloudflare.com/?to=/:account/turnstile
# Leave blank to disable CAPTCHA (e.g. in dev/test)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
