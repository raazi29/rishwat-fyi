# Base URL of the Rishwat.fyi API (apps/api). Server-side calls use this value.
API_BASE_URL=http://localhost:8787

# Same base URL exposed to the browser for client-side status lookups.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8787

# Canonical site origin, used for metadata, sitemap and robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# When the API is unreachable, render the bundled sample dataset instead of an
# error state. Every page that does so shows a visible "sample data" strip.
# Set to "false" in production so outages surface as outages.
NEXT_PUBLIC_ALLOW_SAMPLE_FALLBACK=true
