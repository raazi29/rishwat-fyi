{
  "name": "@rishwat/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "create-admin": "tsx --env-file-if-exists=../../.env src/scripts/create-admin.ts",
    "export": "tsx --env-file-if-exists=../../.env src/scripts/export-dataset.ts",
    "recompute": "tsx --env-file-if-exists=../../.env src/scripts/recompute-aggregates.ts",
    "purge-evidence": "tsx --env-file-if-exists=../../.env src/scripts/purge-evidence.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.0",
    "@hono/zod-validator": "^0.4.0",
    "@rishwat/database": "*",
    "@rishwat/validation": "*",
    "@sentry/node": "^8.55.2",
    "@supabase/storage-js": "^2.7.0",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.6.0",
    "jose": "^5.9.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.19.43",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20.6"
  }
}
