# Local dev/test (Docker PostGIS)
DATABASE_URL=postgres://rishwat:rishwat_dev@localhost:5434/rishwat
TEST_DATABASE_URL=postgres://rishwat:rishwat_dev@localhost:5434/rishwat_test

# Production (Supabase managed Postgres — same schema, connection-string swap only)
# DATABASE_URL=postgresql://postgres.rishwat:PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres

PORT=8787
JWT_SECRET=change-me-to-a-long-random-string

# REQUIRED in production (boot fails without it). Server-side secret that keys
# the HMAC-SHA256 used for ip_hash and device_fingerprint_hash. A bare SHA-256 of
# an IP is effectively reversible: the whole ~4.3-billion-address IPv4 space can
# be precomputed into a lookup table in minutes, so hashing an IP without a
# secret leaks the raw IP. Keying with this secret — which an attacker does not
# have — defeats that rainbow-table reversal. Use a long random string, keep it
# secret, and DO NOT reuse JWT_SECRET. Must be >= 32 chars and not this
# placeholder outside tests. Rotating it invalidates all existing hashes.
IP_HASH_SECRET=change-me-to-a-long-random-ip-hash-secret
ADMIN_EMAIL=admin@rishwat.fyi
ADMIN_PASSWORD=change-me
# local | supabase. NODE_ENV=production REFUSES to boot on `local` unless
# ALLOW_LOCAL_EVIDENCE=true: container filesystems are ephemeral, so uploads
# would return 201 and then be destroyed on the next redeploy while the database
# rows survive pointing at nothing. Set ALLOW_LOCAL_EVIDENCE=true only if
# EVIDENCE_STORAGE_DIR is a genuinely persistent mounted volume.
EVIDENCE_STORAGE_DRIVER=local
EVIDENCE_STORAGE_DIR=./data/evidence     # used when driver=local
SUPABASE_URL=https://your-project.supabase.co   # used when driver=supabase
SUPABASE_SERVICE_ROLE_KEY=               # used when driver=supabase
SUPABASE_STORAGE_BUCKET=evidence         # used when driver=supabase

# REQUIRED in production (boot fails without it). This value is PUBLISHED, not
# just used internally: it builds the download links in GET /datasets that every
# mirror consumes, and the `servers[]` entry in the OpenAPI document. Left to its
# localhost default, a deployment ships an unusable dataset index downstream.
PUBLIC_BASE_URL=http://localhost:8787
EXPORT_DIR=./data/exports                # where `npm run export` writes dataset files
ADMIN_NAME=Admin                         # display name used by `npm run create-admin`

# --- Abuse / integrity controls -------------------------------------------
# How many reverse proxies YOU operate in front of the API. This decides whether
# x-forwarded-for is believed, and it matters a lot: the client IP becomes the
# report's ip_hash, and `count(distinct ip_hash) >= 2` is the only independence
# check gating auto-corroboration and public aggregate publication. It is also
# the rate-limit bucket key.
#   0 = no proxy. Forwarding headers are IGNORED entirely; only the real socket
#       peer address is used. Safe default — keep it unless a proxy is truly there.
#   1 = one trusted proxy (e.g. Cloudflare, or a single nginx). The 1st entry from
#       the RIGHT of x-forwarded-for is used — the last value a client cannot forge.
#   2 = two chained trusted proxies (e.g. Cloudflare -> your load balancer), etc.
# Setting this higher than the number of proxies you actually run does NOT let
# anyone forge their IP — a chain shorter than the configured hop count is
# rejected outright and falls through to the socket peer — but it does collapse
# those requests into one shared identity, which is its own problem.
#
# Setting it LOWER than reality is the common production mistake: on a PaaS
# (Railway, Render, Fly) or behind Cloudflare/nginx, the socket peer is always
# the proxy, so 0 means every client on the internet shares ONE rate-limit
# bucket and ONE ip_hash — "3 reports/hour per person" silently becomes "3
# reports/hour, globally", and `count(distinct ip_hash) >= 2` can never be
# reached, so no aggregate is ever published. The API logs a warning at boot if
# it sees 0 in production. On Render behind its edge proxy, use 1.
TRUSTED_PROXY_HOPS=0

# Master switch for abuse rate limiting (report submission 3/hour, admin login,
# evidence uploads). Defaults to true outside tests.
# WARNING: setting this to false DISABLES ALL RATE LIMITING, including
# brute-force protection on admin login. Never set it false in production.
RATE_LIMIT_ENABLED=true

# --- CORS ------------------------------------------------------------------
# The public API (/health, /search, /services, /locations, /reports, /evidence,
# /datasets, /doc) always sends `Access-Control-Allow-Origin: *` — it is meant to
# be openly consumable. /admin/* does NOT: its responses include IP-hash prefixes
# and moderation data. Leave this UNSET to send no CORS headers for /admin at all
# (correct for a same-origin or server-rendered admin UI). Only set it if the
# admin UI is served from a different origin. Comma-separated, exact origins.
# ADMIN_CORS_ORIGINS=https://admin.rishwat.fyi,http://localhost:5173

# Sentry error tracking for the API. Leave blank to disable.
SENTRY_DSN=

# Cloudflare Turnstile server-side secret for /report CAPTCHA verification.
# The API validates the token before accepting a report submission.
# Leave blank to skip verification (dev/test only).
TURNSTILE_SECRET_KEY=
